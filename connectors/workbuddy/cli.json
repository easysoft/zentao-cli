{
  "runtime": {
    "type": "node",
    "version": "22"
  },
  "init": {
    "darwin": "npm install -g zentao-cli@0.4.4 --no-audit --no-fund",
    "linux": "npm install -g zentao-cli@0.4.4 --no-audit --no-fund",
    "win32": "npm.cmd install -g zentao-cli@0.4.4 --no-audit --no-fund"
  },
  "auth": {
    "darwin": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 290000 auth login --web --no-open --select",
    "linux": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 290000 auth login --web --no-open --select",
    "win32": "zentao.cmd --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 290000 auth login --web --no-open --select"
  },
  "authWaitForExit": true,
  "authUrlDomain": "127.0.0.1",
  "status": {
    "darwin": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 2500 --deadline 8000 --no-input auth status --verify --format=json",
    "linux": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 2500 --deadline 8000 --no-input auth status --verify --format=json",
    "win32": "zentao.cmd --config \"~/.config/zentao/workbuddy.json\" --timeout 2500 --deadline 8000 --no-input auth status --verify --format=json"
  },
  "statusMatch": "\"ok\"\\s*:\\s*true",
  "unAuth": {
    "darwin": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 25000 --no-input auth logout --all --revoke --format=json",
    "linux": "zentao --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 25000 --no-input auth logout --all --revoke --format=json",
    "win32": "zentao.cmd --config \"~/.config/zentao/workbuddy.json\" --timeout 5000 --deadline 25000 --no-input auth logout --all --revoke --format=json"
  },
  "versionCheck": {
    "command": {
      "darwin": "zentao --version",
      "linux": "zentao --version",
      "win32": "zentao.cmd --version"
    },
    "minVersion": "0.4.4"
  },
  "env": {
    "ZENTAO_URL": "",
    "ZENTAO_ACCOUNT": "",
    "ZENTAO_PASSWORD": "",
    "ZENTAO_TOKEN": ""
  }
}
